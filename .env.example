# Anthropic API key — the single shared key for the whole AI workforce.
# Loaded by the FastAPI sidecar at startup.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
AIEMPLOYER_PORT=8737
# Worker model id (default: claude-opus-5). Override when routing through a
# gateway/proxy that serves different model names.
#AIEMPLOYER_MODEL=claude-opus-5